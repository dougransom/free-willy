# ==============================================================================
# Google Antigravity & Agentic IDE
# ==============================================================================
# Local Antigravity IDE and agent runtime state
.gemini/
.antigravity/
.agy/
brain/
scratch/

# Preserve workspace agent skills and rules, ignore temporary agent logs/runs
!.agents/
!.agents/skills/
!.agents/rules/
.agents/*/.system_generated/
.agents/**/logs/

# ==============================================================================
# Environment Variables, Secrets & Credentials
# ==============================================================================
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml

# ==============================================================================
# Node.js & Web Tooling
# ==============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
out/
.next/
.turbo/
.cache/

# ==============================================================================
# Python Tooling & Virtual Environments
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ==============================================================================
# Prolog (Scryer, SWI, Trealla) Temporary Artifacts
# ==============================================================================
*.qlf
*.so
*.dylib
*.dll

# ==============================================================================
# Operating System & Editor Files
# ==============================================================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
